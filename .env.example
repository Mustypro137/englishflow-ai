# EnglishFlow AI — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values there.
# `.env.local` is git-ignored. Never commit real secrets, and never prefix a secret
# with NEXT_PUBLIC_ (that would send it to the browser).
#
# The current version (Milestone 2) needs the Database and Authentication values.
# Everything else is optional for now and documented here so the full configuration
# lives in one place. See docs/DEPLOYMENT_PLAN.md §3.

# --- Database (required) ---------------------------------------------------
# Pooled Postgres connection string used by the app (Neon: Connect -> pooling ON).
# Use sslmode=verify-full at the end of the address.
DATABASE_URL=
# Direct (non-pooled) connection string used by Prisma migrations (pooling OFF).
DIRECT_URL=
# Optional: separate database for integration tests. If empty, tests use DIRECT_URL
# with an isolated "englishflow_test" schema, so development data is never touched.
TEST_DATABASE_URL=

# --- Authentication (required) ---------------------------------------------
# Long random secret, e.g. generated with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL the site is opened at, e.g. http://localhost:3000 or https://your-app.vercel.app
# It must match the address in the browser, or sign-in requests are rejected.
BETTER_AUTH_URL=

# --- Email (optional in development; required before public launch) -------
# Without these, development prints verification/reset emails to the terminal,
# and email verification is NOT required at sign-up.
RESEND_API_KEY=
EMAIL_FROM=
# Set to "false" to allow sign-in before email verification even when email is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=

# --- AI tutor (needed from Milestone 6) ------------------------------------
# Leave AI_PROVIDER empty to run without AI (the app shows a setup message).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Model for the tutor and writing feedback, e.g. claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5
AI_MODEL=
# Optional cheaper model for simple generation tasks
AI_MODEL_FAST=
AI_DAILY_TOKEN_BUDGET_PER_USER=
AI_REQUESTS_PER_MINUTE_PER_USER=

# --- Audio storage (needed from Milestone 7) -------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Error monitoring (needed from Milestone 8) ----------------------------
SENTRY_DSN=
