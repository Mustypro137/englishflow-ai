{
  "name": "englishflow-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/check-env.mjs DIRECT_URL DATABASE_URL && prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --project integration",
    "db:seed": "tsx prisma/seed.ts",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "audio:plan": "tsx scripts/generate-audio.ts",
    "audio:generate": "tsx scripts/generate-audio.ts --generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/blob": "2.8.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
